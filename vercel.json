{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "callflix-web": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "callflix-web" } }
  ]
}