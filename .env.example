# Copy to .env (gitignored) for local runs. On Render, set these in the
# dashboard (dashboard vars win over this file). All entries are optional —
# server.js has safe defaults for local development.

# --- Server ---
PORT=3001
# Comma-separated browser origins allowed by Express + Socket.IO CORS.
# Must list the exact Vercel frontend origin(s) in production.
CLIENT_ORIGIN=http://localhost:5173

# --- Room lifecycle ---
# ROOM_IDLE_TTL_MS=1800000

# --- ICE / TURN (served to clients at runtime via GET /api/ice-config) ---
# Precedence: Twilio NTS > TURN_URLS > built-in OpenRelay demo fallback.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_TTL_SECONDS=3600
# TURN_URLS=turn:host.example.com:3478?transport=udp,turn:host.example.com:3478?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# --- Movie proxy (optional; defaults to the public GitHub release mp4) ---
# MOVIE_SOURCE_URL=

# --- Client-side build var: NOT set here. Configure on Vercel (and as the
# GitHub Actions repository variable VITE_SERVER_URL) ---
# VITE_SERVER_URL=
